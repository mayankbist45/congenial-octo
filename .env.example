# Copy to .env and fill in. Never commit .env.

# --- Angel One SmartAPI (https://smartapi.angelbroking.com) ---
# Create an app of type "Trading API" to get the API key.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
# Base32 TOTP secret shown when you enable 2FA/TOTP for the API.
ANGELONE_TOTP_SECRET=

# --- LLM provider (OpenAI-compatible) ---
OPENAI_API_KEY=
# Override for Anthropic/Gemini/local via an OpenAI-compatible gateway.
OPENAI_BASE_URL=

# --- Journal database ---
# Overrides database.url in settings.yaml. Set this when the DSN carries a
# password or points somewhere other than the local server.
#   DATABASE_URL=postgresql://user:password@localhost:5432/mutualfund
DATABASE_URL=

# --- Alpaca Markets (US equities, optional) ---
# Only used when connectors.broker: alpaca in settings.yaml
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Operational ---
# Set to "true" to block all real order placement, even after approval.
# This is also what confines unattended auto-approval to paper trading: with
# DRY_RUN=false the fund will not approve its own trades.
DRY_RUN=true
# Starting capital for NAV tracking when the fund has no broker history yet.
INITIAL_CAPITAL_INR=1000000
