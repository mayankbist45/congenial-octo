# Copy to .env and fill in. Never commit .env.

# --- Angel One SmartAPI (https://smartapi.angelbroking.com) ---
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=

# Second SmartAPI app — reserved for swing analyse/close (keeps intraday on primary).
ANGELONE_DATA2_API_KEY=
ANGELONE_DATA2_CLIENT_CODE=
ANGELONE_DATA2_PIN=
ANGELONE_DATA2_TOTP_SECRET=
# --- LLM providers ---
# Select one with LLM_PROVIDER=deepseek|groq|kimi|openai. The config default is
# DeepSeek. Keep credentials for multiple providers to switch without editing code.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=

# --- Research workspace subscriptions (Razorpay) ---
# Leave disabled until the plan, secrets, webhook, and launch timestamp are configured.
WORKSPACE_BILLING_ENABLED=false
WORKSPACE_BILLING_DEV_SIMULATE=false
WORKSPACE_TRIAL_DAYS=60
WORKSPACE_BILLING_LAUNCH_AT=
WORKSPACE_PLAN_LABEL=Nivelo Research
WORKSPACE_PLAN_PRICE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_SANDBOX=
RAZORPAY_PLAN_DESK=
RAZORPAY_PLAN_FUND=
RAZORPAY_PLAN_ENTERPRISE=
RAZORPAY_WEBHOOK_SECRET=
# Optional only for a custom OpenAI-compatible provider. Named providers use
# their configured endpoints in config/settings.yaml.
OPENAI_BASE_URL=

# --- Curated research sources ---
# Keep production values only on the VM. Source clients return explicit unavailable
# coverage until these credentials and disclosure retrieval are approved.
EODHD_API_TOKEN=
SEC_USER_AGENT=
WORKSPACE_PRIMARY_DISCLOSURES_ENABLED=false
# BSE corporate disclosures require a licensed BSE market-data feed.
BSE_DISCLOSURES_URL=
BSE_DATAFEED_API_KEY=

# --- Journal database ---
DATABASE_URL=

# --- Alpaca Markets (US equities, optional) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Kronos deployment overrides (optional) ---
KRONOS_DEVICE=
KRONOS_BACKEND=
KRONOS_ENDPOINT_URL=
KRONOS_HF_CACHE_DIR=

# --- Operational ---
DRY_RUN=true
INITIAL_CAPITAL_INR=1000000

# --- WhatsApp EOD persona digest (Twilio) ---
# Official WhatsApp APIs cannot join a normal consumer group. Practical setup:
# 1) Create a Twilio account + enable WhatsApp sandbox (or approved sender).
# 2) Each person who should get the digest joins the sandbox / is opted in.
# 3) Put their numbers in WHATSAPP_TO (comma-separated). That is the "group".
WHATSAPP_ENABLED=true
# Account SID from console home — must start with AC (not SK)
TWILIO_ACCOUNT_SID=
# Option A (simplest): Auth Token from console home (Show)
TWILIO_AUTH_TOKEN=
# Option B: API Key — keep AC in TWILIO_ACCOUNT_SID, then:
# TWILIO_API_KEY=SKxxxxxxxx
# TWILIO_AUTH_TOKEN=<api key secret>
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Comma-separated E.164 numbers, e.g. +9198xxxxxxxx,+1415xxxxxxx
WHATSAPP_TO=
