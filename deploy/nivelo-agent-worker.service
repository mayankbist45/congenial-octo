[Unit]
Description=Nivelo Temporal research-agent worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fund
WorkingDirectory=/opt/fund
EnvironmentFile=/etc/nivelo/agent-worker.env
ExecStart=/usr/bin/docker run --rm --name nivelo-agent-worker --env-file /etc/nivelo/agent-worker.env nivelo-agent-worker:latest
ExecStop=/usr/bin/docker stop -t 30 nivelo-agent-worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
