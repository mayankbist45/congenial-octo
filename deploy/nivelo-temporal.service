[Unit]
Description=Nivelo Temporal server and private dashboard
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/fund
ExecStart=/opt/fund/scripts/temporal_compose.sh --env-file /etc/nivelo/temporal.env -f deploy/temporal-compose.yml up -d --build --remove-orphans
ExecStop=/opt/fund/scripts/temporal_compose.sh --env-file /etc/nivelo/temporal.env -f deploy/temporal-compose.yml stop
TimeoutStartSec=10min
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
