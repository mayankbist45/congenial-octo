# Copy to /etc/nivelo/agent-worker.env on the production host. Do not commit it.
# The worker connects to host PostgreSQL through Docker's host gateway.
DATABASE_URL=postgresql://fund:REPLACE_ON_HOST@host.docker.internal:5432/mutualfund
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
WORKSPACE_AGENT_MODEL=REPLACE_WITH_APPROVED_PROVIDER_MODEL
OPENAI_API_KEY=REPLACE_ON_HOST
